{
  "name": "ippm",
  "version": "1.0.2",
  "description": "Interactive Posts",
  "main": "index.js",
  "scripts": {
    "build": "npm run rimraf && npm run wp-scripts:build && rollup -c",
    "rimraf": "rimraf themes/ippm/build && rimraf plugins/interactive-posts-ippm/build",
    "start": "npm run wp-env:start",
    "watch": "concurrently npm:rimraf npm:wp-scripts:start \"rollup -c --watch\"",
    "wp-env:path": "wp-env install-path",
    "wp-env:plugins": "wp-env run cli wp plugin install wordpress-importer",
    "wp-env:start": "wp-env start --update",
    "wp-env:stop": "wp-env stop",
    "wp-scripts:build": "wp-scripts build --webpack-src-dir=plugins/interactive-posts-ippm/blocks --output-path=plugins/interactive-posts-ippm/build/blocks",
    "wp-scripts:format": "wp-scripts format",
    "wp-scripts:start": "wp-scripts start --webpack-src-dir=plugins/interactive-posts-ippm/blocks --output-path=plugins/interactive-posts-ippm/build/blocks"
  },
  "author": "Hasani Rogers <dev@hasanirogers.me>",
  "license": "ISC",
  "devDependencies": {
    "@open-wc/eslint-config": "^7.0.0",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@wordpress/env": "^10.6.0",
    "@wordpress/scripts": "^28.6.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.20.0",
    "eslint-config-prettier": "^8.5.0",
    "mini-css-extract-plugin": "^2.6.1",
    "postcss-loader": "^7.0.1",
    "prettier": "^2.7.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.21.2",
    "rollup-plugin-minify-html-literals-v3": "^1.3.4",
    "rollup-plugin-sass": "^1.13.2",
    "sass": "^1.54.0",
    "stylelint": "^14.9.1",
    "stylelint-config-sass-guidelines": "9.0.1",
    "stylelint-webpack-plugin": "^3.3.0"
  },
  "dependencies": {
    "@glidejs/glide": "^3.5.2",
    "@lit/react": "^1.0.5",
    "fullpage.js": "^4.0.9",
    "include-media": "^1.4.10",
    "kemet-ui": "^3.0.1",
    "lit": "^2.2.8"
  }
}
